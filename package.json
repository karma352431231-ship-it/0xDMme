{
  "name": "0xdmme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env src/server/main.ts",
    "probe:crypto": "node src/server/probe.ts",
    "probe:wallet-recovery": "node src/server/wallet-recovery-probe.ts",
    "probe:mobile": "node src/server/mobile-probe.ts",
    "probe:zk:prepare": "node src/tools/prepare-zk.ts",
    "probe:zk": "node src/tools/zk-probe.ts",
    "probe:measure": "node src/tools/measure-probes.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run boundaries && npm run licenses && npm run format:check && npm run build && npm run build:evaluation && npm test && npm run test:deploy && npm run test:evaluation",
    "build:evaluation": "node src/tools/build-moderation-evaluation.ts",
    "test:evaluation": "python3 -m unittest discover -s tests -p 'moderation_evaluation_test.py'",
    "test:deploy": "python3 -m unittest discover -s tests -p 'deploy_*_test.py'",
    "deploy:prepare": "python3 infra/staging/deploy.py --prepare",
    "deploy:check": "python3 infra/staging/deploy.py --check",
    "deploy:staging": "python3 infra/staging/deploy.py --activate",
    "deploy:blocks45": "python3 infra/staging/deploy_blocks45.py --activate",
    "build": "node src/tools/build-web.ts",
    "test:integration": "node --env-file-if-exists=.local/web-test.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "licenses": "node src/tools/check-licenses.ts",
    "observe:database": "node --env-file-if-exists=.env src/tools/observe-database.ts",
    "dev:mobile": "npm run build && node --env-file=.local/web-test.env src/server/web-mobile.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "libsodium-wrappers": "0.8.4",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "underscore": "1.13.8",
    "circomkit": {
      "circom_tester": "0.0.24"
    }
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@scure/base": "2.4.0",
    "@solana/wallet-standard-util": "1.1.4",
    "@spruceid/siwe-parser": "3.0.0",
    "@wallet-standard/app": "1.1.1",
    "ethers": "6.17.0",
    "pg": "8.23.1",
    "qr": "0.7.2",
    "web-push": "3.6.7"
  },
  "license": "SEE LICENSE IN LICENSES.md"
}
