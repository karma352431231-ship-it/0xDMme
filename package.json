{
  "name": "hash-talk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server/main.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run boundaries && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
