# Desenvolvimento somente em loopback; banco/objetos exclusivos do 0xDMme.
HASH_TALK_PROFILE=development
HASH_TALK_PORT=45100
HASH_TALK_DATABASE_URL=postgresql://hash_talk_dev@127.0.0.1:45432/hash_talk_dev
HASH_TALK_OBJECT_DIRECTORY=.local/objects
# Teto lógico de conteúdo usado/em upload: 3 GB; calibrar disco antes da publicação.
HASH_TALK_ACCOUNT_CAPACITY_BYTES=3000000000
# Opcional. ID público do projeto Reown, mantido em .local/. SDK ainda em revisão.
# HASH_TALK_WALLETCONNECT_PROJECT_ID=
# Opcional: chaves VAPID do backend. Sem elas, chat/som funcionam; envio push indisponível.
# Gerar com a CLI da biblioteca web-push e guardar somente no ambiente privado.
# HASH_TALK_PUSH_PUBLIC_KEY=
# HASH_TALK_PUSH_PRIVATE_KEY=
