# Modelo somente para staging isolado; não usar como configuração pronta.
# Senha real deve ser gerada na VPS e permanecer fora do Git.
HASH_TALK_PROFILE=staging
HASH_TALK_PUBLIC_ORIGIN=https://0xdmme.app
HASH_TALK_PORT=45113
HASH_TALK_DATABASE_URL=postgresql://hash_talk_stage:REPLACE_ON_SERVER@127.0.0.1:45433/hash_talk_stage
HASH_TALK_OBJECT_DIRECTORY=/var/lib/0xdmme/data/objects/content
# Ambiente de testes: reserva lógica para três contas, sem alterar cotas de produto.
HASH_TALK_ACCOUNT_CAPACITY_BYTES=900000000
