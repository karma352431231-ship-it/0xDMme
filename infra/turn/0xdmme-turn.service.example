[Unit]
Description=0xDMme isolated TURN relay (review before activation)
After=network-online.target
Requires=0xdmme-egress.service
After=0xdmme-egress.service

[Service]
Type=simple
User=xdmme-turn
Group=xdmme-turn
Slice=xdmme-test.slice
ExecStart=/opt/0xdmme-turn/bin/turnserver -c /etc/0xdmme-turn/turnserver.conf
RuntimeDirectory=0xdmme-turn
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
LimitNOFILE=512
TasksMax=48
MemoryMax=128M
MemorySwapMax=0
CPUQuota=20%
StandardOutput=null
StandardError=null
ReadOnlyPaths=/etc/0xdmme-turn
ProtectProc=invisible
PrivateDevices=yes
TemporaryFileSystem=/opt:ro /srv:ro /var:ro /etc:ro /run:ro
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=8M
BindReadOnlyPaths=/opt/0xdmme-turn /etc/0xdmme-turn /etc/passwd /etc/group /etc/localtime
BindPaths=/run/0xdmme-turn
ReadWritePaths=/run/0xdmme-turn

[Install]
WantedBy=multi-user.target
