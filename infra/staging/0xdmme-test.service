[Unit]
Description=0xDMme isolated wallet login test environment
Requires=0xdmme-postgres-test.service var-lib-0xdmme-data.mount
After=0xdmme-postgres-test.service var-lib-0xdmme-data.mount
JoinsNamespaceOf=0xdmme-postgres-test.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=xdmme-test
Group=xdmme-test
Slice=xdmme-test.slice
RuntimeDirectory=0xdmme-web
RuntimeDirectoryMode=0711
EnvironmentFile=/etc/0xdmme/web.env
WorkingDirectory=/opt/0xdmme/release
ExecStart=/usr/bin/node src/server/main.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
MemorySwapMax=0
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TemporaryFileSystem=/opt:ro /srv:ro /var:ro /etc:ro
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=16M
TemporaryFileSystem=/run:ro
InaccessiblePaths=-/usr/local -/usr/src -/mnt -/media
BindReadOnlyPaths=/var/lib/0xdmme/data/release:/opt/0xdmme/release /etc/passwd /etc/group /etc/localtime
BindPaths=/var/lib/0xdmme/data/objects /run/0xdmme-web
ReadWritePaths=/run/0xdmme-web
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
