[Unit]
Description=0xDMme exclusive PostgreSQL test cluster
Requires=var-lib-0xdmme-data.mount
After=var-lib-0xdmme-data.mount
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=xdmme-db
Group=xdmme-db
Slice=xdmme-test.slice
ExecStart=/usr/lib/postgresql/16/bin/postgres -D /var/lib/0xdmme/data/postgres
ExecStartPost=/usr/bin/timeout 60s /bin/sh -c 'until /usr/lib/postgresql/16/bin/pg_isready --quiet --host=127.0.0.1 --port=45433; do /bin/sleep 1; done'
TimeoutStartSec=70
RuntimeDirectory=0xdmme-postgres
RuntimeDirectoryMode=0700
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=48
OOMScoreAdjust=500
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TemporaryFileSystem=/opt:ro /srv:ro /var:ro /etc:ro
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=16M
TemporaryFileSystem=/run:ro
InaccessiblePaths=-/usr/local -/usr/src -/mnt -/media
BindReadOnlyPaths=/etc/passwd /etc/group /etc/localtime
BindPaths=/var/lib/0xdmme/data/postgres /run/0xdmme-postgres
ReadWritePaths=/run/0xdmme-postgres
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
