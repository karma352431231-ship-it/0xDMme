[Unit]
Description=0xDMme community ranking producer
Requires=0xdmme-postgres-test.service var-lib-0xdmme-data.mount
After=0xdmme-postgres-test.service var-lib-0xdmme-data.mount
JoinsNamespaceOf=0xdmme-postgres-test.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=xdmme-test
Group=xdmme-test
Slice=xdmme-test.slice
EnvironmentFile=/etc/0xdmme/web.env
Environment=NODE_OPTIONS=--max-old-space-size=64
WorkingDirectory=/opt/0xdmme/release
ExecStart=/usr/bin/node src/server/worker.ts ranking
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
CPUQuota=10%
MemoryMax=160M
MemorySwapMax=0
TasksMax=24
OOMScoreAdjust=600
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
TemporaryFileSystem=/opt:ro /srv:ro /var:ro /etc:ro
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=16M
TemporaryFileSystem=/run:ro
InaccessiblePaths=-/usr/local -/usr/src -/mnt -/media
BindReadOnlyPaths=/var/lib/0xdmme/data/release:/opt/0xdmme/release /etc/passwd /etc/group /etc/localtime
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
