# TEMPLATE ONLY. Replace UID and sets after reviewing the host privately.
# Install only this table; never flush/replace the host's ruleset.
# Empty provider/resolver sets deliberately block delivery until reviewed.
define push_uid = 99999
table inet xdmme_push {
  set providers4 { type ipv4_addr; }
  set providers6 { type ipv6_addr; }
  set resolvers4 { type ipv4_addr; }
  set resolvers6 { type ipv6_addr; }
  chain output {
    type filter hook output priority 10; policy accept;
    meta skuid $push_uid ip daddr @resolvers4 udp dport 53 accept
    meta skuid $push_uid ip daddr @resolvers4 tcp dport 53 accept
    meta skuid $push_uid ip6 daddr @resolvers6 udp dport 53 accept
    meta skuid $push_uid ip6 daddr @resolvers6 tcp dport 53 accept
    meta skuid $push_uid ip daddr @providers4 tcp dport 443 accept
    meta skuid $push_uid ip6 daddr @providers6 tcp dport 443 accept
    meta skuid $push_uid reject
  }
}
