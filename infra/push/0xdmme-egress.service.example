[Unit]
Description=0xDMme scoped TURN and push egress filters
Before=0xdmme-turn.service 0xdmme-push.service

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=xdmme-test.slice
ExecStart=/usr/sbin/nft --file /etc/0xdmme/egress.nft
ExecStop=/usr/sbin/nft delete table inet xdmme_push
ExecStop=/usr/sbin/nft delete table inet xdmme_turn
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CPUQuota=5%
MemoryMax=32M
MemorySwapMax=0
TasksMax=8
LimitCORE=0
TimeoutStartSec=10
TimeoutStopSec=10
StandardOutput=null
StandardError=null
